name: Update news

on:
  schedule:
    - cron: "0 */6 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Get the repository files
        uses: actions/checkout@v4

      - name: Install Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install the libraries fetch.py needs
        run: pip install -r requirements.txt

      - name: Fetch the feeds and build news.json
        run: python fetch.py

      - name: Save news.json back to the repository
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add news.json
          git diff --staged --quiet || git commit -m "News update $(date -u '+%Y-%m-%d %H:%M UTC')"
          git push
